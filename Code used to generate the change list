typedef struct textPos {
	int place;
	int line;
	int total;
} textPos;
static void freeArray(WCHAR** array, int count) 
{
	if (array == NULL) {
		return;
	}
	for (int i = 0; i < count; i++) {
		free(array[i]);
	}
	free(array);
}
static int getWStringLength(WCHAR* string) {
	if (string == NULL) {
		return -1;
	}
	int length = 0;
	WCHAR ch = string[length];
	while (ch != L'\0') {
		length++;
		ch = string[length];
	}
	return length;
}
static WCHAR** getFileNames(LPCWSTR location, int* counter, WCHAR*** list, WCHAR* prefix, int number, WCHAR* fileEnding) {
	if (counter == NULL) {
		printf("error: counter was null\n");
		return NULL;
	}
	if (location == NULL) {
		printf("error: location was null\n");
		return NULL;
	}
	WIN32_FIND_DATA data;
	HANDLE fileFind = FindFirstFileW(location, &data);
	if (fileFind == INVALID_HANDLE_VALUE) {
		printf("Error couldn't find\n");
		return NULL;
	}
	int folderCount = 0;
	int folderSize = 8;
	WCHAR** folderArray = (WCHAR**)malloc(sizeof(WCHAR*) * 8);
	int count = 0;
	int size = 16;
	WCHAR** fileArray;
	if (list == NULL || *counter <= 0) {
		fileArray = (WCHAR**)malloc(sizeof(WCHAR*) * size);
	}
	else {
		fileArray = *list;
		count = *counter;
		while (size <= count) {
			size *= 2;
		}
	}
	if (fileArray == NULL) {
		printf("Critical error\n");
		return NULL;
	}
	WCHAR* temp;
	do {
		WCHAR* ext = wcsrchr(data.cFileName, L'.');
		if (ext && wcscmp(ext, fileEnding) == 0) {
			temp = (WCHAR*)malloc(sizeof(WCHAR) * MAX_PATH);
			if (temp == NULL) {
				printf("error\n");
				freeArray(fileArray, count);
				freeArray(folderArray, folderCount);
				return NULL;
			}
			if (prefix == NULL || number <= 0) {
				fileArray[count] = wcscpy(temp, data.cFileName);
			}
			else {
				wcscpy(temp, prefix);
				fileArray[count] = wcscat(temp, data.cFileName);
			}
			count++;
			if (count >= size) {
				size *= 2;
				fileArray = (WCHAR**)realloc(fileArray, sizeof(WCHAR*) * size);
				if (fileArray == NULL) {
					printf("Critical error, size:%d\n", size);
					freeArray(folderArray, folderCount);
					return NULL;
				}
			}
		}
		else {
			if (data.dwFileAttributes & FILE_ATTRIBUTE_DIRECTORY) {
				if (wcscmp(data.cFileName, L".") && wcscmp(data.cFileName, L"..")) {
					temp = (WCHAR*)malloc(sizeof(WCHAR) * MAX_PATH);
					if (temp == NULL) {
						printf("error\n");
						freeArray(fileArray, count);
						freeArray(folderArray, folderCount);
						return NULL;
					}
					if (prefix == NULL || number <= 0) {
						folderArray[folderCount] = wcscpy(temp, data.cFileName);
					}
					else {
						wcscpy(temp, prefix);
						folderArray[count] = wcscat(temp, data.cFileName);
					}
					folderCount++;
					if (folderCount >= folderSize) {
						folderSize *= 2;
						folderArray = (WCHAR**)realloc(folderArray, sizeof(WCHAR*) * folderSize);
						if (!folderArray) {
							printf("Critical error, size:%d, folderSIze is %d\n", size, folderSize);
							freeArray(fileArray, count);
							return NULL;
						}
					}
				}
			}
		}
	} while (FindNextFileW(fileFind, &data));
	FindClose(fileFind);
	for (int i = 0; i < folderCount; i++) {
		WCHAR subFolder[MAX_PATH];
		WCHAR ch = location[0];
		int tempCount = 0;
		while (ch != L'\0' && ch != L'*') {
			subFolder[tempCount] = ch;
			tempCount++;
			ch = location[tempCount];
		}
		ch = (folderArray[i])[0];
		int keeper = 0;
		while (ch != L'\0') {
			subFolder[tempCount] = ch;
			tempCount++;
			keeper++;
			ch = (folderArray[i])[keeper];
		}
		subFolder[tempCount] = L'\\';
		subFolder[tempCount + 1] = L'*';
		subFolder[tempCount + 2] = L'\0';
		if (tempCount > MAX_PATH - 3) {
			printf("WARNING\nWARNING\nWARNING\nWARNING\n");
		}
		int preLength = number + getWStringLength(folderArray[i]);
		WCHAR* pre = (WCHAR*)malloc(sizeof(WCHAR) * (preLength + 2));
		if (pre == NULL) {
			printf("memory error\n");
			exit(1);
		}
		if (number != 0 && prefix != NULL) {
			wcscpy(pre, prefix);
			pre = wcscat(pre, folderArray[i]);
		}
		else {
			wcscpy(pre, folderArray[i]);
		}
		pre[preLength] = L'\\';
		pre[preLength + 1] = L'\0';
		fileArray = getFileNames(subFolder, &count, &fileArray, pre, preLength + 1, fileEnding);
		free(pre);
	}
	free(folderArray);
	*counter = count;
	if (list != NULL) {
		*list = fileArray;
	}
	return fileArray;
}
static textPos areFilesDifferent(const char* file1, const char* file2) {
	FILE* ptr1 = fopen(file1, "r");
	if (ptr1 == NULL) {
		perror("fopen failed1");
		printf("|%s|\n", file1);
		textPos t = { -1, -1, -1 };
		return t;
	}
	FILE* ptr2 = fopen(file2, "r");
	if (ptr2 == NULL) {
		perror("fopen failed2");
		printf("|%s|\n", file2);
		fclose(ptr1);
		textPos t = { -1, -1, -1 };
		return t;
	}
	int ch1;
	int ch2;
	textPos pos = { 1,1,1 };
	ch1 = fgetc(ptr1);
	ch2 = fgetc(ptr2);
	while (ch1 != EOF && ch2 != EOF) {
		if (ch1 != ch2) {
			fclose(ptr1);
			fclose(ptr2);
			return pos;
		}
		pos.total++;
		pos.place++;
		if (ch1 == '\n') {
			pos.line++;
			pos.place = 1;
		}
		ch1 = fgetc(ptr1);
		ch2 = fgetc(ptr2);
	}
	fclose(ptr1);
	fclose(ptr2);
	pos.place = 0;
	if (ch1 != ch2) {
		return pos;
	}
	pos.total = 0;
	pos.line = 0;
	return pos;
}
static char* makeFilePath(const char* location, int length1,  const WCHAR* name, int length2) {
	if (location == NULL || name == NULL) {
		printf("missing information!");
		return NULL;
	}
	if (length1 + length2 > MAX_PATH) {
		printf("too long");
		return NULL;
	}
	char* result = (char*)malloc(sizeof(char) * MAX_PATH);
	if (result == NULL) {
		printf("memory error");
		return NULL;
	}
	int temp;
	int i = 0;
	while (i < length1) {
		if (location[i] == '\0') {
			break;
		}
		result[i] = location[i];
		i++;
	}
	for (int j = 0; j < length2; j++) {
		if (name[j] == L'\0') {
			break;
		}
		temp = (int)name[j];
		if (temp <= 0 || temp >= 128) {
			printf("\'%lc\' = [%d] is too large for a char\n", name[j], temp);
			free(result);
			return NULL;
		}
		else {
			result[i] = (char)temp;
		}
		i++;
	}
	result[i] = '\0';
	return result;

}
static int printDifferences(WCHAR** arrayFirst, int size1, char* loc1, int len1, WCHAR** arraySecond, int size2, char* loc2, int len2) {
	int size = size1;
	if (size2 > size1) {
		size = size2;
	}
	int place1 = 0;
	int place2 = 0;
	int compare;
	while (place1 < size1 && place2 < size2) {
		compare = StrCmpLogicalW(arrayFirst[place1], arraySecond[place2]);
		if (compare == 0) {
			char* file1 = makeFilePath(loc1, len1, arrayFirst[place1], MAX_PATH - len1 - 1);
			if (file1 == NULL) {
				printf("An error has occurred!\n");
				place1++;
				place2++;
				continue;
			}
			char* file2 = makeFilePath(loc2, len2, arraySecond[place2], MAX_PATH - len2 - 1);
			if (file2 == NULL) {
				printf("An error has occurred!\n");
				free(file1);
				place1++;
				place2++;
				continue;
			}
			textPos diff = areFilesDifferent(file1, file2);
			if (diff.total == -1) {
				free(file1);
				free(file2);
				return -1;
			}
			if (diff.total != 0) {
				printf("%d: %ls had changes from position %d (line %d place %d)\n", place1, arrayFirst[place1], diff.total, diff.line, diff.place);
			}

			free(file1);
			free(file2);
			place1++;
			place2++;
		}
		if (compare > 0) {
			printf("%ls new file\n", arraySecond[place2]);
			place2++;
		}
		if (compare < 0) {
			printf("%d: %ls file deleted\n", place1, arrayFirst[place1]);
			place1++;
		}

	}
}
static WCHAR* makePathIntoWCHAR(char* path, int length) {
	int len = MultiByteToWideChar(CP_ACP, 0, path, -1, NULL, 0);
	if (len == 0) {
		printf("something went wrong while casting the path from char to WCHAR (1)\n");
		return NULL;
	}
	WCHAR* result = (WCHAR*)malloc(sizeof(WCHAR) * (len + 1));
	if (result == NULL) {
		printf("something went wrong while casting the path from char to WCHAR\n");
		printf("malloc broke, no idea why, not dealing with that (6)\n");
		return NULL;
	}
	if (MultiByteToWideChar(CP_ACP, 0, path, -1, result, len) == 0) {
		printf("something went wrong while casting the path from char to WCHAR (2)\n");
		free(result);
		return NULL;
	}
	result[len - 1] = L'*';
	result[len] = L'\0';
	return result;
}
